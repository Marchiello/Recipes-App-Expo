    {
      "id": 158,
      "name": "Corned Beef Hash",
      "description": "Corned beef hash is a hearty, flavorful dish combining diced corned beef, potatoes, and onions, pan-fried until crispy and golden, commonly served for breakfast or brunch.",
      "difficulty": "easy",
      "meal_type": "main",
      "cuisine": "american",
      "dietary_tags": [
        "dairy_free",
        "gluten_free",
        "nut_free"
      ],
      "servings": 4,
      "prep_time": 10,
      "cook_time": 20,
      "calories_per_serving": 350,
      "protein": 20,
      "instructions": [
        "Heat vegetable oil in a large skillet over medium heat.",
        "Add finely diced onion and cook until translucent, about 3-4 minutes.",
        "Add diced cooked potato to the skillet and cook until potatoes begin to brown, about 5-7 minutes.",
        "Add chopped corned beef and cook, stirring occasionally, until everything is heated through and slightly crispy, about 5 minutes.",
        "Season with salt and black pepper to taste and stir in chopped fresh parsley if using.",
        "Serve hot, optionally topped with a fried egg."
      ],
      "ingredients": [
        {
          "id": 6,
          "name": "Salt",
          "category": "condiment",
          "quantity": 1,
          "unit": "pinch",
          "optional": false
        },
        {
          "id": 7,
          "name": "Black pepper",
          "category": "condiment",
          "quantity": 1,
          "unit": "pinch",
          "optional": false
