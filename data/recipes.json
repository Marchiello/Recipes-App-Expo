    {
      "id": 6084,
      "name": "Sancocho Canario (Traditional Canary Islands Stew)",
      "description": "Sancocho Canario is a traditional hearty meat and vegetable stew from the Canary Islands known for its rich flavors and diverse root vegetables.",
      "difficulty": "medium",
      "meal_type": "main",
      "cuisine": "spanish",
      "dietary_tags": [
        "gluten_free",
        "nut_free",
        "halal",
        "kosher"
      ],
      "servings": 4,
      "prep_time": 25,
      "cook_time": 75,
      "calories_per_serving": 450,
      "protein": 35,
      "instructions": [
        "Cut the beef into large cubes and season with salt and pepper.",
        "Peel and chop the potatoes, corn on the cob into chunks, yams, and sweet potatoes into large pieces.",
        "Peel and slice the plantain into thick rounds.",
        "In a large pot, heat the olive oil over medium heat and brown the beef cubes on all sides.",
        "Add the chopped garlic and diced onion to the pot and sauté until translucent.",
        "Pour in the beef broth and bring to a boil, then reduce heat and simmer for about 30 minutes to tenderize the meat.",
        "Add the chopped potatoes, yams, sweet potatoes, corn chunks, and plantain to the pot.",
        "Season with ground cumin and bay leaf, and add salt to taste.",
        "Continue to simmer the stew gently for another 45 minutes or until all the vegetables and meat are tender, stirring occasionally.",
        "Remove the bay leaf and check seasoning, adjusting with salt or pepper as needed.",
        "Serve hot, garnished with fresh parsley if desired."
      ],
