    {
      "id": 6086,
      "name": "Puchero Canario (Traditional Canary Islands Stew)",
      "description": "Puchero Canario is a traditional hearty stew from the Canary Islands made with a variety of meats, vegetables, and legumes simmered together to create a flavorful and comforting dish.",
      "difficulty": "medium",
      "meal_type": "main",
      "cuisine": "spanish",
      "dietary_tags": [
        "gluten_free",
        "nut_free"
      ],
      "servings": 4,
      "prep_time": 20,
      "cook_time": 105,
      "calories_per_serving": 450,
      "protein": 38,
      "instructions": [
        "Fill a large pot with water and bring it to a boil.",
        "Add the meat cuts: beef, pork ribs, and chicken, and simmer gently for about 1 hour to create a rich broth.",
        "Skim off any foam that rises to the surface during simmering to keep the broth clear.",
        "Add the garbanzo bean, peeled and halved potato, peeled sweet potato, pumpkin pieces, and corn on the cob cut into sections to the pot.",
        "Season with salt, black pepper, and add a pinch of saffron for flavor and color.",
        "Continue simmering for another 45 minutes until all vegetables and meat are tender.",
        "Towards the end, add the green beans and carrot pieces, cooking until just tender.",
        "Adjust seasoning if needed.",
        "Serve the stew hot, presenting the broth and ingredients together, allowing diners to enjoy the rich flavors and textures.",
        "Optionally, sprinkle fresh parsley over the dish before serving."
      ],
