    {
      "id": 156,
      "name": "Corned Beef and Cabbage",
      "description": "Corned beef and cabbage is a traditional Irish-American dish featuring slow-cooked corned beef brisket served with boiled cabbage, potatoes, and carrots. It is famed for its hearty flavors and tender meat.",
      "difficulty": "medium",
      "meal_type": "main",
      "cuisine": "american",
      "dietary_tags": [
        "dairy_free",
        "gluten_free",
        "nut_free"
      ],
      "servings": 6,
      "prep_time": 15,
      "cook_time": 180,
      "calories_per_serving": 450,
      "protein": 35,
      "instructions": [
        "Rinse the corned beef brisket under cold water and place it in a large pot.",
        "Add water to the pot until the corned beef is fully submerged.",
        "Add the spice packet that comes with the corned beef or add your own spices such as peppercorns, bay leaf, and mustard seeds.",
        "Bring the water to a boil, then reduce the heat to a simmer and cover the pot.",
        "Cook the corned beef for about 2 and a half to 3 hours until tender.",
        "About 30 minutes before the corned beef is done, add the peeled and cut potatoes and carrots to the pot.",
        "Add the cabbage wedges during the last 15 minutes of cooking, allowing it to soften but remain slightly firm.",
        "Remove the corned beef from the pot and let it rest for 10 minutes before slicing against the grain.",
        "Serve the sliced corned beef with the cooked cabbage, potatoes, and carrots, spooning some cooking liquid over the top for added flavor."
      ],
