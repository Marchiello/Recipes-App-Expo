    {
      "id": 140,
      "name": "Classic American Beef Stew",
      "description": "This Classic American Beef Stew is a hearty and comforting dish made with tender beef, root vegetables, and a rich broth slowly simmered to perfection.",
      "difficulty": "medium",
      "meal_type": "main",
      "cuisine": "american",
      "dietary_tags": [
        "dairy_free",
        "gluten_free",
        "nut_free"
      ],
      "servings": 4,
      "prep_time": 20,
      "cook_time": 135,
      "calories_per_serving": 450,
      "protein": 40,
      "instructions": [
        "Cut the beef chuck into bite-sized cubes and pat them dry with paper towels.",
        "Season the beef cubes with salt and black pepper.",
        "Heat vegetable oil in a large heavy pot over medium-high heat and brown the beef in batches until all sides are seared. Remove beef and set aside.",
        "In the same pot, add diced onion, chopped carrot, and chopped celery. Cook until vegetables begin to soften, about 5 minutes.",
        "Add minced garlic and tomato paste, stirring for one minute until fragrant.",
        "Pour in beef broth and red wine, scraping the bottom of the pot to loosen browned bits.",
        "Return the seared beef to the pot. Add bay leaf and thyme sprig.",
        "Bring the stew to a boil, then reduce heat to low, cover, and simmer for about 1.5 to 2 hours until beef is tender.",
        "Add peeled and chopped potato and cook uncovered for an additional 30 minutes until potatoes are tender and stew has thickened.",
        "Remove bay leaf and thyme sprig. Stir in chopped fresh parsley before serving."
      ],
