    {
      "id": 8282,
      "name": "Noppei Jiru (Thick Vegetable Soup)",
      "description": "Noppei Jiru is a traditional Japanese thick vegetable soup made with root vegetables and konnyaku in a dashi broth, thickened with potato starch for a comforting texture.",
      "difficulty": "medium",
      "meal_type": "soup",
      "cuisine": "japanese",
      "dietary_tags": [
        "vegetarian",
        "gluten_free",
        "dairy_free",
        "nut_free",
        "halal",
        "kosher"
      ],
      "servings": 4,
      "prep_time": 15,
      "cook_time": 30,
      "calories_per_serving": 120,
      "protein": 3,
      "instructions": [
        "Wash and peel the carrot and daikon radish, then cut them into bite-sized pieces.",
        "Remove the stalks from the shiitake mushroom and slice the caps thinly.",
        "Peel and cut the potato into cubes.",
        "Cut the konnyaku into small pieces and boil briefly to remove odor, then drain.",
        "Slice the burdock into thin strips and soak in water to remove bitterness.",
        "Heat the sesame oil in a pot over medium heat, and sauté the carrot, daikon, shiitake, potato, konnyaku, and burdock for a few minutes until slightly tender.",
        "Add dashi stock to the pot and bring to a boil.",
        "Reduce heat and simmer until all vegetables are tender, about 15-20 minutes.",
        "Mix the potato starch with water to make a slurry.",
        "Gradually add the potato starch slurry to the simmering soup while stirring to thicken the broth.",
        "Season with soy sauce and salt to taste.",
        "Serve hot, garnished with chopped mitsuba leaves."
      ],
